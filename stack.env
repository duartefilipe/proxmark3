# Valores padrao usados pelo Portainer no deploy via Repository.
# A senha real deve ser definida em "Environment variables" na tela da stack,
# que tem precedencia sobre este arquivo.

PM3_WEB_PORT=8787
PM3_DEVICE=/dev/ttyACM0

PM3_PGHOST=192.168.31.229
PM3_PGPORT=15432
PM3_PGDATABASE=proxmark
PM3_PGUSER=proxmark
PM3_PGPASSWORD=defina_na_tela_da_stack
